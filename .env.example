# ==============================================================================
# Portfolio OS - Environment Variables
# ==============================================================================

# GROQ Cloud API Key for Apple Intelligence Spotlight
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (defaults to openai/gpt-oss-120b if omitted)
GROQ_MODEL=openai/gpt-oss-120b
